            while ((line = reader.readLine()) != null) {

                String[] data = line.split(",");

                if (data.length >= 4) {

                    Customer customer = new Customer(
                            data[0],
                            data[1],
                            data[2],
                            data[3]
                    );

                    customers.add(customer);
                }
            }

        } catch (IOException e) {
            System.out.println("Could not read customer file.");
        }

        return customers;
    }

    public static Customer registerCustomer(
